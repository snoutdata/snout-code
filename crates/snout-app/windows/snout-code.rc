// The resources of snout-code.exe: its icon (GPUI gives the window resource 1) and what
// Explorer's Details show. The manifest (per-monitor DPI awareness) is GPUI's own.
#include <winver.h>

1 ICON SNOUT_ICON

VS_VERSION_INFO VERSIONINFO
FILEVERSION SNOUT_VERSION_NUMBERS
PRODUCTVERSION SNOUT_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Snoutdata"
            VALUE "FileDescription", "SnoutCode"
            VALUE "FileVersion", SNOUT_VERSION
            VALUE "InternalName", "snout-code"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "snout-code.exe"
            VALUE "ProductName", "SnoutCode"
            VALUE "ProductVersion", SNOUT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
